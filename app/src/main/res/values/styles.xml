<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- os 2 carView abaixo -->
       <style name="BaseCardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">4dp</item>
       </style>

       <style name="LinealBaseCardView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">16dp</item>
        <item name="android:orientation">vertical</item>
        </style>

    
        <!-- Estilo para ScrollView -->
        <style name="ScrollViewStyle">
            <item name="android:layout_width">match_parent</item>
            <item name="android:layout_height">match_parent</item>
            <item name="android:background">@color/backgroundApp</item>
            <item name="android:padding">20dp</item>
        </style>

        <!-- Estilo para LinearLayout principal -->
        <style name="LinearLayoutVerticalStyle">
            <item name="android:layout_width">match_parent</item>
            <item name="android:layout_height">wrap_content</item>
            <item name="android:gravity">center</item>
            <item name="android:padding">16dp</item>
            <item name="android:orientation">vertical</item>
        </style>

        <!-- Estilo para LinearLayout horizontal -->
        <style name="LinearLayoutHorizontalStyle">
            <item name="android:layout_width">match_parent</item>
            <item name="android:layout_height">wrap_content</item>
            <item name="android:orientation">horizontal</item>
        </style>
    </resources>
